<Window x:Class="AutoAdatbázis.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoAdatbázis"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="800" ResizeMode="NoResize">
    <Grid Background="Azure">
        <Grid.RowDefinitions>
            <RowDefinition Height="240"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <Label Content="Autó adatbázis" FontSize="24" HorizontalAlignment="Center" Margin="10, 0, 0, 0"/>
            <Label Content="Válasszon egy autómárkát!" FontSize="16" Margin="10, 0, 0, 0"/>
            <ComboBox x:Name="BrandComboBox" Width="200" Height="30" HorizontalAlignment="Left" Margin="10, 0, 0, 0">
                <ComboBoxItem Content="Audi"/>
                <ComboBoxItem Content="BMW"/>
                <ComboBoxItem Content="Mercedes"/>
            </ComboBox>
            <Label Content="Válasszon egy típust!" FontSize="16" Margin="10, 0, 0, 0"/>
            <ComboBox x:Name="typeComboBox" Width="200" Height="30" HorizontalAlignment="Left" Margin="10, 0, 0, 0">
                <ComboBoxItem Content="A4"/>
                <ComboBoxItem Content="330d"/>
                <ComboBoxItem Content="C220d"/>
            </ComboBox>
            <Label Content="Válassza ki az évjáratot!" FontSize="16" Margin="10, 0, 0, 0"/>
            <TextBox x:Name="YearTextBox" Width="200" Height="30" HorizontalAlignment="Left" Margin="10, 0, 0, 0"/>
        </StackPanel>
        <DataGrid x:Name="dataGrid" Grid.Row="1">

        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Törlés" Width="100" Height="40" Margin="20 0 20 0" Click="Delete"/>
            <Button Content="Keresés" Width="100" Height="40" Margin="60 0 60 0" HorizontalAlignment="Center" Click="Search"/>
            <Button Content="Módosítás" Width="100" Height="40" Margin="60 0 60 0" HorizontalAlignment="Center" Click="Modify"/>
            <Button Content="Kilépés" Width="100" Height="40" Margin="20 0 20 0" Click="Exit"/>
        </StackPanel>
    </Grid>
</Window>
