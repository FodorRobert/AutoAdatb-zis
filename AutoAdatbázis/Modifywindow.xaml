<Window x:Class="AutoAdatbázis.Modifywindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoAdatbázis"
        mc:Ignorable="d"
        Title="Modifywindow" Height="350" Width="350" ResizeMode="NoResize">
    <Grid Background="Azure">
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
            <Label Content="Módosítás" FontSize="24" HorizontalAlignment="Center" Margin="10, 0, 0, 0"/>
            <Label Content="Márka:" FontSize="16" Margin="10, 0, 0, 0"/>
            <TextBox x:Name="BrandTextBox" Width="200" Height="30" HorizontalAlignment="Left" Margin="10, 0, 0, 0"/>
            <Label Content="Típus:" FontSize="16" Margin="10, 0, 0, 0"/>
            <TextBox x:Name="TypeTextBox" Width="200" Height="30" HorizontalAlignment="Left" Margin="10, 0, 0, 0"/>
            <Label Content="Évjárat:" FontSize="16" Margin="10, 0, 0, 0"/>
            <TextBox x:Name="YearTextBox" Width="200" Height="30" HorizontalAlignment="Left" Margin="10, 0, 0, 10"/>
            <Button Content="Mentés" Width="100" Height="40" Margin="20 0 20 0" Click="Save" />
        </StackPanel>
    </Grid>
</Window>
